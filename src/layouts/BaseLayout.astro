---
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto/900.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/500.css';
import '../styles/global.css';
import { SITE, CONTACT, ANALYTICS } from '../config';
import type { Locale } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  path?: string; // 当前页路径（含语言前缀），用于 canonical，如 '/products/arc-400/'、'/es/products/arc-400/'
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  preloadImage?: string; // 首屏关键图预加载
  locale?: Locale;
  alternates?: boolean; // 是否输出 es/ru hreflang（博客等仅英文页关闭）
}
const {
  title,
  description,
  path = '/',
  ogType = 'website',
  ogImage = '/assets/factory/lineup.webp',
  noindex = false,
  preloadImage,
  locale = 'en',
  alternates = true,
} = Astro.props;
const canonical = `${SITE.url}${path}`;
const ogLocale = { en: 'en_US', es: 'es_ES', ru: 'ru_RU' }[locale];
// hreflang：各语言互指（含自身 + x-default 指英文）。path 传入的应是不含语言前缀的页面路径。
const basePath = path.startsWith('/es/') || path.startsWith('/ru/') ? path.slice(3) : path;
const alternatesList = alternates
  ? [
      { lang: 'en', href: `${SITE.url}${basePath}` },
      { lang: 'es', href: `${SITE.url}/es${basePath}` },
      { lang: 'ru', href: `${SITE.url}/ru${basePath}` },
      { lang: 'x-default', href: `${SITE.url}${basePath}` },
    ]
  : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternatesList.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}${ogImage}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {
      ANALYTICS.ga4Id && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`} />
      )
    }
    {
      ANALYTICS.ga4Id && (
        <script is:inline define:vars={{ ga4Id: ANALYTICS.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {'{'}
          dataLayer.push(arguments);
          {'}'}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      )
    }
  </head>
  <body class="font-sans text-gray-800 bg-brand-light">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloat locale={locale} />
  </body>
</html>
