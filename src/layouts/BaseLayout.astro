---
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto/900.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/500.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/tajawal/900.css';
import '../styles/global.css';
import { SITE, CONTACT, ANALYTICS } from '../config';
import { locales, type Locale } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  path?: string; // 当前页路径（含语言前缀），用于 canonical，如 '/products/arc-400/'、'/es/products/arc-400/'
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  preloadImage?: string; // 首屏关键图预加载
  locale?: Locale;
  alternates?: boolean; // 是否输出 es/ru hreflang（博客等仅英文页关闭）
}
const {
  title,
  description,
  path = '/',
  ogType = 'website',
  ogImage = '/assets/factory/lineup.webp',
  noindex = false,
  preloadImage,
  locale = 'en',
  alternates = true,
} = Astro.props;
const canonical = `${SITE.url}${path}`;
const ogLocaleMap: Record<Locale, string> = { en: 'en_US', es: 'es_ES', ru: 'ru_RU', vi: 'vi_VN', ar: 'ar_AR' };
const ogLocale = ogLocaleMap[locale];
// hreflang：各语言互指（含 x-default 指英文），语种清单来自 i18n/ui.ts——新增语言自动带上
const basePath = path.replace(/^\/(es|ru|vi|ar)(?=\/)/, '');
const alternatesList = alternates
  ? [
      ...locales.map((l) => ({ lang: l, href: `${SITE.url}${l === 'en' ? basePath : `/${l}${basePath}`}` })),
      { lang: 'x-default', href: `${SITE.url}${basePath}` },
    ]
  : [];
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternatesList.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}${ogImage}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {
      ANALYTICS.ga4Id && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`} />
      )
    }
    {
      ANALYTICS.ga4Id && (
        <script is:inline define:vars={{ ga4Id: ANALYTICS.ga4Id }}>
          // 注意：本内联脚本刻意不写花括号——Astro define:vars 模板会破坏 {} 转义
          window.dataLayer = window.dataLayer || [];
          window.gtag = (...args) => window.dataLayer.push(args);
          window.gtag('js', new Date());
          window.gtag('config', ga4Id);
        </script>
      )
    }
  </head>
  <body class="font-sans text-gray-800 bg-brand-light">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloat locale={locale} />
  </body>
</html>
