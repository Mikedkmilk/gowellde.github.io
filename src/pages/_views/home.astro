---
/**
 * 首页视图（locale 感知）。路由包装见 /index.astro、/es/index.astro、/ru/index.astro。
 */
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, CONTACT } from '../../config';
import { getChildCategories, getProducts, getCategory, quickSpecs, getPosts, catName } from '../../lib/data';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;

const featured = (await getProducts()).filter((p) => p.data.featured).slice(0, 6);
const featuredCards = await Promise.all(
  featured.map(async (p) => ({ product: p, specs: quickSpecs(p, (await getCategory(p.data.category))!, locale) }))
);
const children = await getChildCategories('welding-machines');
const posts = (await getPosts()).slice(0, 3);
const productCount = (await getProducts()).length;

const pageTitle =
  locale === 'en'
    ? 'China Inverter Welding Machine Manufacturer | Wholesale MIG & MMA Welders - GOWELLDE'
    : locale === 'vi'
      ? 'Nhà máy sản xuất máy hàn biến tần Trung Quốc | Bán sỉ máy hàn MIG & MMA - GOWELLDE'
      : locale === 'ar'
        ? 'مصنع ماكينات لحام إنفرتر في الصين | جملة ماكينات MIG وMMA - GOWELLDE'
        : `${t(locale, 'hero.title1')} ${t(locale, 'hero.titleAccent')} ${t(locale, 'hero.title2')} - GOWELLDE`;
const pageDesc =
  locale === 'es'
    ? 'GOWELLDE es una fábrica profesional china de soldadoras inversoras: MMA y MIG/MAG IGBT de 160 a 630 A, prueba de envejecimiento 100%, CE/ISO9001, OEM/ODM. Exportamos a Egipto, India, Vietnam y todo el mundo.'
    : locale === 'ru'
      ? 'GOWELLDE — профессиональный китайский завод инверторных сварочных аппаратов: MMA и MIG/MAG IGBT 160-630 А, 100% тест плат, CE/ISO9001, OEM/ODM. Экспорт в Египет, Индию, Вьетнам и по всему миру.'
      : locale === 'vi'
        ? 'GOWELLDE là nhà máy sản xuất máy hàn biến tần chuyên nghiệp tại Trung Quốc: máy hàn IGBT MMA và MIG/MAG 160-630A, test lão hóa 100%, chứng nhận CE/ISO9001, nhận OEM/ODM. Xuất khẩu sang Ai Cập, Ấn Độ, Việt Nam và toàn cầu.'
        : locale === 'ar'
          ? 'GOWELLDE مصنع محترف لماكينات اللحام الإنفرتر في الصين: ماكينات IGBT نوع MMA وMIG/MAG بقدرة 160-630 أمبير، اختبار تعتيق 100%، شهادات CE/ISO9001، وخدمات OEM/ODM. تصدير إلى مصر والهند وفيتنام والعالم.'
          : 'GOWELLDE is a professional China inverter welding machine factory. Wholesale IGBT MIG/MAG and MMA welders 160-630A, 100% board aging test, CE/ISO9001 certified, OEM/ODM. Exporting to Egypt, India, Vietnam and worldwide.';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/assets/brand/logo.webp`,
  description: 'Professional Manufacturer of MMA, MIG/MAG & TIG Inverter Welding Machines in China.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'East of National Road 104',
    addressLocality: 'Tengzhou City',
    addressRegion: 'Shandong Province',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: CONTACT.phoneDisplay,
    contactType: 'sales',
    areaServed: 'Worldwide',
    availableLanguage: ['English', 'Chinese', 'Spanish', 'Russian'],
  },
  sameAs: [CONTACT.facebook, CONTACT.youtube],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path={`${prefix}/`}
  locale={locale}
  preloadImage="/assets/hero/hero-bg.webp"
>
  <!-- Hero：原版式，静态背景图（旧版同款工业焊接场景，本地 WebP） -->
  <section class="relative bg-black text-white">
    <div class="absolute inset-0 bg-cover bg-center opacity-40" style="background-image:url('/assets/hero/hero-bg.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-brand-dark" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 text-center">
      <div class="inline-block px-3 py-1 mb-5 border border-brand-orange text-brand-orange rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase">
        {t(locale, 'hero.badge')}
      </div>
      <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight leading-tight break-words">
        {t(locale, 'hero.title1')} <span class="text-brand-orange">{t(locale, 'hero.titleAccent')}</span><br />{t(locale, 'hero.title2')}
      </h1>
      <p class="text-lg md:text-xl mb-10 text-gray-300 font-light max-w-3xl mx-auto">
        {t(locale, 'hero.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={`${prefix}/products/`} class="bg-brand-orange text-white px-10 py-4 rounded font-bold text-lg hover:bg-orange-600 transition shadow-xl transform hover:scale-105">
          {t(locale, 'hero.cta1')}
        </a>
        <a href="#contact" class="bg-transparent border-2 border-white text-white px-10 py-4 rounded font-bold text-lg hover:bg-white hover:text-brand-dark transition shadow-xl">
          {t(locale, 'hero.cta2')}
        </a>
      </div>
    </div>
  </section>

  <!-- 信任条 -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">15+</p>
        <p class="text-sm text-gray-500">{t(locale, 'trust.yearsL')}</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">10,000㎡</p>
        <p class="text-sm text-gray-500">{t(locale, 'trust.facilityL')}</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">100%</p>
        <p class="text-sm text-gray-500">{t(locale, 'trust.agingL')}</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">20+</p>
        <p class="text-sm text-gray-500">{t(locale, 'trust.marketsL')}</p>
      </div>
    </div>
  </section>

  <!-- 品类入口 -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">{t(locale, 'sec.range')}</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto mb-6"></div>
        <p class="text-gray-600 max-w-2xl mx-auto">{t(locale, 'sec.rangeSub')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {children.map((c) => (
          <a href={`${prefix}/products/${c.data.slug}/`} class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 group grid grid-cols-2">
            <div class="h-56 md:h-64 bg-gray-50 p-6 flex items-center justify-center">
              {c.data.hero && <img src={c.data.hero} alt={catName(c, locale)} width="600" height="450" class="max-h-full max-w-full object-contain group-hover:scale-110 transition duration-500" loading="lazy" />}
            </div>
            <div class="p-6 flex flex-col justify-center">
              <h3 class="text-xl font-black text-brand-dark mb-2 group-hover:text-brand-orange transition">{catName(c, locale)}</h3>
              <p class="text-sm text-gray-500 line-clamp-3 mb-3">{c.data.intro}</p>
              <span class="text-brand-orange font-bold text-sm">{t(locale, 'sec.explore')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 精选产品 -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">{t(locale, 'sec.featured')}</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredCards.map((c) => (
          <ProductCard product={c.product} quickSpecs={c.specs} locale={locale} />
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href={`${prefix}/products/`} class="inline-block border-2 border-brand-dark text-brand-dark px-8 py-3 rounded font-bold hover:bg-brand-dark hover:text-white transition">
          {t(locale, 'sec.viewAllModels')} ({productCount})
        </a>
      </div>
    </div>
  </section>

  <!-- 工厂实力 -->
  <section class="py-20 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6 text-brand-dark">{t(locale, 'sec.why')}</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">{t(locale, 'sec.whyP')}</p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> {t(locale, 'sec.whyB1')}</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> {t(locale, 'sec.whyB2')}</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> {t(locale, 'sec.whyB3')}</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> {t(locale, 'sec.whyB4')}</li>
        </ul>
        <div class="border-t border-gray-100 pt-6">
          <p class="text-sm font-bold text-gray-400 uppercase mb-4">{t(locale, 'certs.label')}</p>
          <div class="flex gap-6">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-xl mb-1">CE</div>
              <span class="text-xs text-gray-500">{t(locale, 'certs.ce')}</span>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-sm mb-1 text-center leading-tight">ISO<br />9001</div>
              <span class="text-xs text-gray-500">{t(locale, 'certs.iso')}</span>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-xl mb-1">CCC</div>
              <span class="text-xs text-gray-500">{t(locale, 'certs.ccc')}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="relative group">
        <img src="/assets/factory/why-choose.webp" alt="Industrial welding workshop" width="1200" height="900" class="rounded shadow-2xl w-full aspect-[4/3] object-cover group-hover:scale-[1.02] transition" loading="lazy" />
        <div class="absolute -bottom-6 -right-6 bg-brand-dark text-white p-6 rounded shadow-lg hidden md:block border-b-4 border-brand-orange">
          <p class="text-2xl font-bold text-brand-orange">15+</p>
          <p class="text-sm">{t(locale, 'trust.yearsL')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 博客导流（博客暂仅英文） -->
  <section class="py-20 bg-brand-light border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">{t(locale, 'sec.guides')}</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto mb-6"></div>
        <p class="text-gray-600 max-w-2xl mx-auto">{t(locale, 'sec.guidesSub')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 group flex flex-col">
            <div class="h-48 bg-gray-100 overflow-hidden">
              {post.data.image && (
                <img src={post.data.image} alt={post.data.title} width="1200" height="800" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
              )}
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <p class="text-xs text-gray-400 mb-2">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                {post.data.tags.length > 0 && <span class="text-brand-orange font-semibold ml-3">{post.data.tags[0]}</span>}
              </p>
              <h3 class="text-lg font-bold text-brand-dark mb-2 group-hover:text-brand-orange transition leading-tight">{post.data.title}</h3>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{post.data.description}</p>
              <span class="text-brand-orange font-bold text-sm mt-4">Read article →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/blog/" class="text-brand-orange font-bold hover:underline">{t(locale, 'sec.allArticles')}</a>
      </div>
    </div>
  </section>

  <!-- 询盘 -->
  <section id="contact" class="py-20 bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-14">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-8">{t(locale, 'contact.title')}</h2>
        <p class="text-gray-400 mb-10">{t(locale, 'contact.sub')}</p>
        <div class="space-y-7">
          <a href={`mailto:${CONTACT.email}`} class="flex items-center group">
            <div class="w-12 h-12 bg-brand-orange rounded-full flex items-center justify-center mr-4 group-hover:scale-110 transition">
              <Icon name="mail" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">{t(locale, 'contact.emailL')}</p>
              <p class="text-lg font-bold break-all group-hover:text-brand-orange transition">{CONTACT.email}</p>
            </div>
          </a>
          <a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener" class="flex items-center group">
            <div class="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center mr-4 group-hover:bg-green-600 transition">
              <Icon name="whatsapp" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">WhatsApp / WeChat</p>
              <p class="text-lg font-bold group-hover:text-green-500 transition">{CONTACT.whatsappDisplay}</p>
            </div>
          </a>
          <div class="flex items-start">
            <div class="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
              <Icon name="map-pin" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">{t(locale, 'contact.addrL')}</p>
              <p class="text-base leading-snug">{CONTACT.address}</p>
            </div>
          </div>
        </div>
      </div>
      <InquiryForm locale={locale} />
    </div>
  </section>

  <JsonLd data={orgLd} />
</BaseLayout>
