---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/data';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.data.title },
];

const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image ? `${SITE.url}${post.data.image}` : undefined,
  author: { '@type': 'Organization', name: SITE.legalName },
  publisher: {
    '@type': 'Organization',
    name: SITE.legalName,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/assets/brand/logo.webp` },
  },
  datePublished: post.data.pubDate.toISOString(),
  mainEntityOfPage: `${SITE.url}/blog/${post.id}/`,
};
---

<BaseLayout title={`${post.data.title} | GOWELLDE Blog`} description={post.data.description} path={`/blog/${post.id}/`} ogType="article" ogImage={post.data.image} alternates={false}>
  <article class="py-12 bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={crumbs} />

      {post.data.image && (
        <img src={post.data.image} alt={post.data.title} width="1200" height="800" class="w-full rounded-lg shadow-lg mb-8" />
      )}

      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400 mb-4">
        <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {post.data.tags.map((t) => (
          <span class="text-brand-orange bg-orange-50 px-2.5 py-1 rounded font-medium">{t}</span>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-brand-dark leading-tight mb-8">{post.data.title}</h1>

      <div class="prose prose-lg max-w-none prose-headings:font-black prose-headings:text-brand-dark prose-a:text-brand-orange">
        <Content />
      </div>

      <div class="not-prose mt-12 bg-white border border-gray-100 rounded-lg p-8 text-center shadow-sm">
        <h2 class="text-xl font-bold text-brand-dark mb-2">Questions about welding machines?</h2>
        <p class="text-gray-500 mb-5">Our engineers answer within 24 hours — wholesale prices, specs, OEM projects.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="bg-brand-dark text-white px-6 py-3 rounded font-bold hover:bg-brand-orange transition">Contact Sales</a>
          <a href="/products/" class="border-2 border-brand-orange text-brand-orange px-6 py-3 rounded font-bold hover:bg-brand-orange hover:text-white transition">
            View Machines <Icon name="arrow-right" class="w-4 h-4 inline -mt-0.5" />
          </a>
        </div>
      </div>
    </div>
  </article>

  <JsonLd data={postLd} />
</BaseLayout>
