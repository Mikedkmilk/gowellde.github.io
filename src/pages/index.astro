---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, CONTACT } from '../config';
import { getChildCategories, getProducts, getCategory, quickSpecs, getPosts } from '../lib/data';

const featured = (await getProducts()).filter((p) => p.data.featured).slice(0, 6);
const featuredCards = await Promise.all(
  featured.map(async (p) => ({ product: p, specs: quickSpecs(p, (await getCategory(p.data.category))!) }))
);
const children = await getChildCategories('welding-machines');
const posts = (await getPosts()).slice(0, 3);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/assets/brand/logo.webp`,
  description: 'Professional Manufacturer of MMA, MIG/MAG & TIG Inverter Welding Machines in China.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'East of National Road 104',
    addressLocality: 'Tengzhou City',
    addressRegion: 'Shandong Province',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: CONTACT.phoneDisplay,
    contactType: 'sales',
    areaServed: 'Worldwide',
    availableLanguage: ['English', 'Chinese'],
  },
  sameAs: [CONTACT.facebook, CONTACT.youtube],
};
---

<BaseLayout
  title="China Inverter Welding Machine Manufacturer | Wholesale MIG & MMA Welders - GOWELLDE"
  description="GOWELLDE is a professional China inverter welding machine factory. Wholesale IGBT MIG/MAG and MMA welders 160-630A, 100% board aging test, CE/ISO9001 certified, OEM/ODM. Exporting to Egypt, India, Vietnam and worldwide."
  path="/"
  preloadImage="/assets/hero/hero-bg.webp"
>
  <!-- Hero：原版式，静态背景图（旧版网页同款工业焊接场景，本地化 WebP） -->
  <section class="relative bg-black text-white">
    <div class="absolute inset-0 bg-cover bg-center opacity-40" style="background-image:url('/assets/hero/hero-bg.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-brand-dark" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 text-center">
      <div class="inline-block px-3 py-1 mb-5 border border-brand-orange text-brand-orange rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase">
        Direct From China Factory • OEM Available
      </div>
      <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight leading-tight">
        CHINA PROFESSIONAL <span class="text-brand-orange">INVERTER</span><br />WELDING MACHINE FACTORY
      </h1>
      <p class="text-lg md:text-xl mb-10 text-gray-300 font-light max-w-3xl mx-auto">
        IGBT MMA and MIG/MAG welders from 160A to 630A. Every board aging-tested. Powering industries in Egypt, India, Pakistan & Vietnam.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/products/" class="bg-brand-orange text-white px-10 py-4 rounded font-bold text-lg hover:bg-orange-600 transition shadow-xl transform hover:scale-105">
          View Machines
        </a>
        <a href="#contact" class="bg-transparent border-2 border-white text-white px-10 py-4 rounded font-bold text-lg hover:bg-white hover:text-brand-dark transition shadow-xl">
          Become Distributor
        </a>
      </div>
    </div>
  </section>

  <!-- 信任条 -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">15+</p>
        <p class="text-sm text-gray-500">Years Manufacturing</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">10,000㎡</p>
        <p class="text-sm text-gray-500">Factory Facility</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">100%</p>
        <p class="text-sm text-gray-500">Board Aging Test</p>
      </div>
      <div class="flex flex-col items-center">
        <p class="text-3xl font-black text-brand-orange">20+</p>
        <p class="text-sm text-gray-500">Export Markets</p>
      </div>
    </div>
  </section>

  <!-- 品类入口 -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">Our Product Range</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto mb-6"></div>
        <p class="text-gray-600 max-w-2xl mx-auto">High-performance IGBT inverter series for every welding job — from 4.1 kg portable stick welders to 630A production machines.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {children.map((c) => (
          <a href={`/products/${c.data.slug}/`} class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 group grid grid-cols-2">
            <div class="h-56 md:h-64 bg-gray-50 p-6 flex items-center justify-center">
              <img src={c.data.hero} alt={c.data.name} width="600" height="450" class="max-h-full max-w-full object-contain group-hover:scale-110 transition duration-500" loading="lazy" />
            </div>
            <div class="p-6 flex flex-col justify-center">
              <h3 class="text-xl font-black text-brand-dark mb-2 group-hover:text-brand-orange transition">{c.data.name}</h3>
              <p class="text-sm text-gray-500 line-clamp-3 mb-3">{c.data.intro}</p>
              <span class="text-brand-orange font-bold text-sm">Explore series →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 精选产品 -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">Featured Machines</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredCards.map((c) => (
          <ProductCard product={c.product} quickSpecs={c.specs} />
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/products/" class="inline-block border-2 border-brand-dark text-brand-dark px-8 py-3 rounded font-bold hover:bg-brand-dark hover:text-white transition">
          View All 16 Models
        </a>
      </div>
    </div>
  </section>

  <!-- 工厂实力 -->
  <section class="py-20 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6 text-brand-dark">Why Choose GOWELLDE?</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          With over 15 years in welding equipment manufacturing, GOWELLDE operates a 10,000㎡ facility producing reliable, cost-effective
          inverters for the global market.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> 100% aging test for every board</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> Top-grade IGBT components</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> Flexible OEM/ODM branding</li>
          <li class="flex items-center text-gray-700"><Icon name="check-circle" class="w-5 h-5 text-brand-orange mr-3" /> Complete accessory package with every MIG</li>
        </ul>
        <div class="border-t border-gray-100 pt-6">
          <p class="text-sm font-bold text-gray-400 uppercase mb-4">Quality Certifications</p>
          <div class="flex gap-6">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-xl mb-1">CE</div>
              <span class="text-xs text-gray-500">Euro Standard</span>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-sm mb-1 text-center leading-tight">ISO<br />9001</div>
              <span class="text-xs text-gray-500">Quality System</span>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 border-2 border-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold text-xl mb-1">CCC</div>
              <span class="text-xs text-gray-500">Safety Cert</span>
            </div>
          </div>
        </div>
      </div>
      <div class="relative group">
        <img src="/assets/factory/why-choose.webp" alt="Industrial welding workshop" width="1200" height="900" class="rounded shadow-2xl w-full aspect-[4/3] object-cover group-hover:scale-[1.02] transition" loading="lazy" />
        <div class="absolute -bottom-6 -right-6 bg-brand-dark text-white p-6 rounded shadow-lg hidden md:block border-b-4 border-brand-orange">
          <p class="text-2xl font-bold text-brand-orange">15+</p>
          <p class="text-sm">Years Experience</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 博客导流 -->
  <section class="py-20 bg-brand-light border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-4 uppercase">Welding Guides & Insights</h2>
        <div class="w-20 h-1.5 bg-brand-orange mx-auto mb-6"></div>
        <p class="text-gray-600 max-w-2xl mx-auto">Practical guides for buyers and distributors on choosing and using industrial welders.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 group flex flex-col">
            <div class="h-48 bg-gray-100 overflow-hidden">
              {post.data.image && (
                <img src={post.data.image} alt={post.data.title} width="1200" height="800" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
              )}
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <p class="text-xs text-gray-400 mb-2">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                {post.data.tags.length > 0 && <span class="text-brand-orange font-semibold ml-3">{post.data.tags[0]}</span>}
              </p>
              <h3 class="text-lg font-bold text-brand-dark mb-2 group-hover:text-brand-orange transition leading-tight">{post.data.title}</h3>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{post.data.description}</p>
              <span class="text-brand-orange font-bold text-sm mt-4">Read article →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/blog/" class="text-brand-orange font-bold hover:underline">View all articles →</a>
      </div>
    </div>
  </section>

  <!-- 询盘 -->
  <section id="contact" class="py-20 bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-14">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-8">Start Your Inquiry</h2>
        <p class="text-gray-400 mb-10">
          Looking for a reliable factory partner? Send us your requirements. We offer competitive wholesale pricing for distributors and importers.
        </p>
        <div class="space-y-7">
          <a href={`mailto:${CONTACT.email}`} class="flex items-center group">
            <div class="w-12 h-12 bg-brand-orange rounded-full flex items-center justify-center mr-4 group-hover:scale-110 transition">
              <Icon name="mail" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">Sales Email</p>
              <p class="text-lg font-bold break-all group-hover:text-brand-orange transition">{CONTACT.email}</p>
            </div>
          </a>
          <a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener" class="flex items-center group">
            <div class="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center mr-4 group-hover:bg-green-600 transition">
              <Icon name="whatsapp" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">WhatsApp / WeChat</p>
              <p class="text-lg font-bold group-hover:text-green-500 transition">{CONTACT.whatsappDisplay}</p>
            </div>
          </a>
          <div class="flex items-start">
            <div class="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
              <Icon name="map-pin" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-sm text-gray-400">Factory Address</p>
              <p class="text-base leading-snug">{CONTACT.address}</p>
            </div>
          </div>
        </div>
      </div>
      <InquiryForm />
    </div>
  </section>

  <JsonLd data={orgLd} />
</BaseLayout>
