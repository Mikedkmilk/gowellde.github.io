---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | GOWELLDE" description="The page you are looking for does not exist." path="/404.html" noindex alternates={false}>
  <section class="py-28 bg-brand-light text-center">
    <div class="max-w-xl mx-auto px-4">
      <p class="text-7xl font-black text-brand-orange mb-4">404</p>
      <h1 class="text-2xl font-bold text-brand-dark mb-3">Page not found</h1>
      <p class="text-gray-500 mb-8">The page may have been moved. Try our product catalog instead.</p>
      <div class="flex justify-center gap-4 flex-col sm:flex-row">
        <a href="/products/" class="bg-brand-orange text-white px-6 py-3 rounded font-bold hover:bg-orange-600 transition">View Products</a>
        <a href="/" class="border-2 border-brand-dark text-brand-dark px-6 py-3 rounded font-bold hover:bg-brand-dark hover:text-white transition">Back to Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
