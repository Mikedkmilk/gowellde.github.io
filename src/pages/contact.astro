---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CONTACT } from '../config';
---

<BaseLayout
  title="Contact GOWELLDE - Get Wholesale Welding Machine Quotes in 24h"
  description="Contact the GOWELLDE welding machine factory for wholesale prices, OEM/ODM projects and technical support. WhatsApp, email or inquiry form — we reply within 24 hours."
  path="/contact/"
>
  <section class="bg-brand-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
      <h1 class="text-4xl font-black uppercase mb-4">Contact the Factory</h1>
      <p class="text-gray-300 max-w-2xl">Wholesale quotes, OEM projects, technical questions — our sales engineers reply within 24 hours (Mon–Sat).</p>
    </div>
  </section>

  <section class="py-16 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="space-y-5">
        <a href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello GOWELLDE, I would like to ask about your welding machines.')}`} target="_blank" rel="noopener" class="flex items-center gap-4 bg-white rounded-lg shadow p-5 group hover:shadow-lg transition">
          <div class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition">
            <Icon name="whatsapp" class="w-7 h-7 text-white" />
          </div>
          <div>
            <p class="text-sm text-gray-400">WhatsApp (fastest)</p>
            <p class="text-lg font-bold text-brand-dark">{CONTACT.whatsappDisplay}</p>
          </div>
        </a>
        <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-4 bg-white rounded-lg shadow p-5 group hover:shadow-lg transition">
          <div class="w-14 h-14 bg-brand-orange rounded-full flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition">
            <Icon name="mail" class="w-6 h-6 text-white" />
          </div>
          <div>
            <p class="text-sm text-gray-400">Sales Email</p>
            <p class="text-lg font-bold text-brand-dark break-all">{CONTACT.email}</p>
          </div>
        </a>
        <div class="flex items-start gap-4 bg-white rounded-lg shadow p-5">
          <div class="w-14 h-14 bg-brand-dark rounded-full flex items-center justify-center flex-shrink-0">
            <Icon name="map-pin" class="w-6 h-6 text-white" />
          </div>
          <div>
            <p class="text-sm text-gray-400">Factory Address</p>
            <p class="text-base font-bold text-brand-dark">{CONTACT.address}</p>
            <p class="text-sm text-gray-500 mt-1">Visitors welcome — 40 min from Tengzhou East high-speed rail station.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 bg-white rounded-lg shadow p-5">
          <div class="w-14 h-14 bg-brand-blue rounded-full flex items-center justify-center flex-shrink-0">
            <Icon name="clock" class="w-6 h-6 text-white" />
          </div>
          <div>
            <p class="text-sm text-gray-400">Working Hours</p>
            <p class="text-base font-bold text-brand-dark">Mon–Sat 8:30–18:00 (GMT+8)</p>
            <p class="text-sm text-gray-500 mt-1">Messages outside hours answered next morning.</p>
          </div>
        </div>
      </div>
      <InquiryForm />
    </div>
  </section>
</BaseLayout>
