---
/**
 * 产品详情页视图（所有品类共用一个模板，参数表由品类 specSchema 驱动）。
 */
import type { Product, Category } from '../lib/data';
import { getProduct, getCategory } from '../lib/data';
import Gallery from './Gallery.astro';
import SpecTable from './SpecTable.astro';
import InquiryForm from './InquiryForm.astro';
import ProductCard from './ProductCard.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import JsonLd from './JsonLd.astro';
import { quickSpecs } from '../lib/data';
import { SITE, CONTACT } from '../config';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const d = p.data;
const category = await getCategory(d.category);
const related = (await Promise.all(d.related.map((slug) => getProduct(slug)))).filter(
  (x): x is Product => Boolean(x)
);
const relatedCards = await Promise.all(
  related.map(async (rp) => ({
    product: rp,
    specs: quickSpecs(rp, (await getCategory(rp.data.category)) as Category),
  }))
);
const cat = category as Category | undefined;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products/' },
  ...(cat ? [{ label: cat.data.name, href: `/products/${cat.data.slug}/` }] : []),
  { label: d.model },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  sku: d.model,
  mpn: d.model,
  brand: { '@type': 'Brand', name: SITE.name },
  description: d.description || d.summary,
  image: d.images.length > 0 ? `${SITE.url}${d.images[0].src}` : undefined,
  category: cat?.data.name,
  additionalProperty: Object.entries(d.specs).map(([k, v]) => ({
    '@type': 'PropertyValue',
    name: cat?.data.specSchema.find((s) => s.key === k)?.label ?? k,
    value: v,
  })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: d.status === 'coming-soon' ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
    url: `${SITE.url}/products/${p.id}/`,
    seller: { '@type': 'Organization', name: SITE.legalName },
  },
};
---

<section class="py-10 bg-brand-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={crumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-14">
      <Gallery images={d.images} />

      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {d.tags.map((t) => (
            <span class="text-xs font-bold text-brand-orange border border-brand-orange px-2 py-0.5 rounded">{t}</span>
          ))}
          {d.status === 'coming-soon' && (
            <span class="text-xs font-bold text-white bg-brand-blue px-2 py-0.5 rounded">COMING SOON</span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-brand-dark mb-2">{d.model}</h1>
        <p class="text-gray-500 mb-6">{d.name}</p>
        {d.summary && <p class="text-gray-700 leading-relaxed mb-6">{d.summary}</p>}

        <div class="flex items-end gap-3 mb-6">
          {d.priceDisplay && <span class="text-4xl font-extrabold text-brand-orange">{d.priceDisplay}</span>}
          <span class="text-xs text-gray-400 uppercase tracking-wide font-medium pb-1.5">FOB Price</span>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-8 text-center">
          {d.moq && (
            <div class="bg-white border border-gray-100 rounded p-3">
              <p class="text-xs text-gray-400 mb-1">MOQ</p>
              <p class="font-bold text-brand-dark">{d.moq}</p>
            </div>
          )}
          {d.leadTimeDays && (
            <div class="bg-white border border-gray-100 rounded p-3">
              <p class="text-xs text-gray-400 mb-1">Lead Time</p>
              <p class="font-bold text-brand-dark">{d.leadTimeDays} days</p>
            </div>
          )}
          <div class="bg-white border border-gray-100 rounded p-3">
            <p class="text-xs text-gray-400 mb-1">Port</p>
            <p class="font-bold text-brand-dark">{d.fobPort}</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <a href="#inquiry" class="flex-1 text-center bg-brand-orange text-white px-6 py-3.5 rounded font-bold hover:bg-orange-600 transition shadow-lg">
            INQUIRE NOW
          </a>
          <a
            href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(`Hello GOWELLDE, I am interested in ${d.model}. Please send me the quotation.`)}`}
            target="_blank" rel="noopener"
            class="flex-1 text-center bg-white border-2 border-green-600 text-green-700 px-6 py-3.5 rounded font-bold hover:bg-green-50 transition flex items-center justify-center gap-2"
          >
            <Icon name="whatsapp" class="w-5 h-5" /> WHATSAPP
          </a>
        </div>

        {cat && quickSpecs(p, cat).length > 0 && (
          <div class="bg-white border border-gray-100 rounded-lg p-5">
            <p class="text-xs font-bold uppercase text-gray-400 mb-3">Quick Specs</p>
            <div class="grid grid-cols-3 gap-3 text-center">
              {quickSpecs(p, cat).map((s) => (
                <div>
                  <p class="text-xs text-gray-400 mb-1">{s.label}</p>
                  <p class="font-mono font-bold text-brand-dark">{s.value}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-14">
      <div class="lg:col-span-2 space-y-10">
        {cat && (
          <div>
            <h2 class="text-2xl font-black text-brand-dark uppercase mb-5">Specifications</h2>
            <SpecTable specs={d.specs} schema={cat.data.specSchema} />
            <p class="text-gray-400 italic text-xs mt-3">
              * Specifications subject to change without notice. Contact us for the latest technical sheet.
            </p>
          </div>
        )}

        {d.description && (
          <div>
            <h2 class="text-2xl font-black text-brand-dark uppercase mb-5">Overview</h2>
            <div class="prose prose-gray max-w-none">
              <p>{d.description}</p>
            </div>
          </div>
        )}

        {d.features.length > 0 && (
          <div>
            <h2 class="text-2xl font-black text-brand-dark uppercase mb-5">Key Features</h2>
            <ul class="space-y-3">
              {d.features.map((f) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <Icon name="check-circle" class="w-5 h-5 text-brand-orange flex-shrink-0 mt-0.5" /> {f}
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.applications.length > 0 && (
          <div>
            <h2 class="text-2xl font-black text-brand-dark uppercase mb-5">Applications</h2>
            <div class="flex flex-wrap gap-2.5">
              {d.applications.map((a) => (
                <span class="bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-full text-sm font-medium">{a}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="space-y-6">
        <InquiryForm model={d.model} id={`inquiry-${p.id}`} />
        {d.downloads.length > 0 && (
          <div class="bg-white rounded-lg shadow p-5">
            <h3 class="font-bold mb-3">Downloads</h3>
            {d.downloads.map((dl) => (
              <a href={dl.href} class="flex items-center gap-2 text-brand-blue hover:underline text-sm mb-2">
                <Icon name="file-text" class="w-4 h-4" /> {dl.label}
              </a>
            ))}
          </div>
        )}
        <div class="bg-white rounded-lg shadow p-5">
          <h3 class="font-bold mb-3">Why buy from GOWELLDE</h3>
          <ul class="space-y-2.5 text-sm text-gray-600">
            <li class="flex gap-2"><Icon name="check-circle" class="w-4 h-4 text-brand-orange flex-shrink-0 mt-0.5" /> 100% aging test on every board</li>
            <li class="flex gap-2"><Icon name="check-circle" class="w-4 h-4 text-brand-orange flex-shrink-0 mt-0.5" /> Top-grade IGBT components</li>
            <li class="flex gap-2"><Icon name="check-circle" class="w-4 h-4 text-brand-orange flex-shrink-0 mt-0.5" /> OEM/ODM branding available</li>
            <li class="flex gap-2"><Icon name="check-circle" class="w-4 h-4 text-brand-orange flex-shrink-0 mt-0.5" /> CE / ISO9001 / CCC certified factory</li>
          </ul>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <div>
        <h2 class="text-2xl font-black text-brand-dark uppercase mb-6">Related Models</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {relatedCards.map((c) => (
            <ProductCard product={c.product} quickSpecs={c.specs} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<JsonLd data={productLd} />
