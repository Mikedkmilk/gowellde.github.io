---
/**
 * 产品卡片：列表页/首页/相关推荐通用。
 * quickSpecs 由 lib/data.ts 的 quickSpecs() 计算（品类 schema 驱动）。
 */
import type { Product } from '../lib/data';
import Icon from './Icon.astro';

interface Props {
  product: Product;
  quickSpecs: { label: string; value: string }[];
  categorySlug?: string;
}
const { product: p, quickSpecs, categorySlug } = Astro.props;
const d = p.data;
const isHot = d.badges.includes('best-seller');
const isNew = d.badges.includes('new');
const comingSoon = d.status === 'coming-soon';
---

<a
  href={`/products/${p.id}/`}
  class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 group relative flex flex-col"
>
  <div class="h-56 bg-gray-50 relative overflow-hidden p-6 flex items-center justify-center">
    {d.images.length > 0 ? (
      <img
        src={d.images[0].src}
        alt={d.images[0].alt}
        width="1000"
        height="750"
        class="max-h-full max-w-full object-contain transform group-hover:scale-110 transition duration-500"
        loading="lazy"
      />
    ) : (
      <span class="text-gray-400 text-sm">Photo on request</span>
    )}
    {d.tags.length > 0 && (
      <div class="absolute top-0 left-0 bg-brand-orange text-white text-xs font-bold px-3 py-1 rounded-br shadow">
        {d.tags[0]}
      </div>
    )}
    {isHot && (
      <div class="absolute top-0 right-0 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-bl shadow">HOT SALE</div>
    )}
    {isNew && (
      <div class="absolute top-0 right-0 bg-brand-blue text-white text-xs font-bold px-3 py-1 rounded-bl shadow">NEW</div>
    )}
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-2xl font-black text-brand-dark mb-3 group-hover:text-brand-orange transition">{d.model}</h3>
    {d.summary && <p class="text-sm text-gray-500 mb-4 line-clamp-2">{d.summary}</p>}

    <div class="space-y-2 mb-5 flex-grow">
      {quickSpecs.map((s) => (
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-400">{s.label}</span>
          <span class="font-mono font-medium text-gray-700">{s.value}</span>
        </div>
      ))}
    </div>

    <div class="mt-auto pt-4 border-t border-gray-100">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-baseline gap-1.5">
          {d.priceDisplay && <span class="text-3xl font-extrabold text-brand-orange">{d.priceDisplay}</span>}
          <span class="text-xs text-gray-400 font-medium uppercase tracking-wide">FOB</span>
        </div>
        {d.moq && <span class="text-xs text-gray-400">MOQ {d.moq}</span>}
      </div>
      <span class={`block w-full text-center py-3 rounded font-bold transition duration-300 shadow-sm ${comingSoon ? 'bg-gray-200 text-gray-600' : 'bg-brand-dark text-white group-hover:bg-brand-orange'}`}>
        {comingSoon ? 'COMING SOON — ASK US' : 'VIEW & INQUIRE'}
      </span>
    </div>
  </div>
</a>
{categorySlug && <span class="hidden">{categorySlug}</span>}
