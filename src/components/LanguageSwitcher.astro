---
/**
 * 语言切换器：按当前路径计算各语言对应 URL。
 * 英文专属页面（博客/法务/404）切换时回落到对应语言首页，避免 404。
 * variant="codes"（PC 紧凑模式，EN/ES/RU/VI/AR）| "names"（移动菜单全名）。
 */
import { locales, type Locale } from '../i18n/ui';

interface Props {
  variant?: 'codes' | 'names';
}
const { variant = 'codes' } = Astro.props;

const names: Record<Locale, string> = {
  en: 'English',
  es: 'Español',
  ru: 'Русский',
  vi: 'Tiếng Việt',
  ar: 'العربية',
};
const codes: Record<Locale, string> = { en: 'EN', es: 'ES', ru: 'RU', vi: 'VI', ar: 'AR' };

const current = (Astro.url.pathname.match(/^\/(es|ru|vi|ar)(?=\/)/)?.[1] ?? 'en') as Locale;
const basePath = Astro.url.pathname.replace(/^\/(es|ru|vi|ar)(?=\/)/, '');
// 英文专属区：博客、法务页、404 —— 其他语言没有对应页面
const enOnly = /^\/(blog|privacy-policy|terms-of-service|404)/.test(basePath);
const hrefFor = (l: Locale) => (l === 'en' ? basePath : enOnly ? `/${l}/` : `/${l}${basePath}`);
const label = (l: Locale) => (variant === 'codes' ? codes[l] : names[l]);
---

<div class="flex flex-wrap items-center gap-1" role="group" aria-label="Language">
  {locales.map((l) =>
    l === current ? (
      <span class="text-xs font-bold px-2 py-1 rounded bg-white/15 text-white" aria-current="true" title={names[l]}>{label(l)}</span>
    ) : (
      <a
        href={hrefFor(l)}
        hreflang={l}
        title={names[l]}
        aria-label={names[l]}
        class="text-xs font-bold px-2 py-1 rounded text-gray-300 hover:text-brand-orange hover:bg-white/10 transition"
      >
        {label(l)}
      </a>
    )
  )}
</div>
